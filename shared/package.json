{
  "name": "@exam-room/shared",
  "version": "0.1.0",
  "private": true,
  "description": "API contract types and the paper and answer rules shared by server and web",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./paper-rules": {
